{
  "name": "promptpilot-enhance",
  "displayName": "PromptEnhancer",
  "description": "Enhance your AI coding prompts before sending them. Right-click or use Cmd+Shift+E to transform rough instructions into structured, actionable prompts.",
  "version": "0.1.0",
  "publisher": "promptenhancer",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptpilot.enhance",
        "title": "PromptEnhancer: Enhance Prompt"
      }
    ],
    "keybindings": [
      {
        "command": "promptpilot.enhance",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "promptpilot.enhance",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}

